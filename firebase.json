{
  "functions": {
    "source": "functions"
  },
  "hosting": [
    {
      "target": "prod",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/corsProxy",
          "function": "corsProxy"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "staging",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/corsProxy",
          "function": "corsProxy"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
